# @name    Apple Music
# @desc    Wie das Original: Cover, Titel, Interpret, Fortschritt. Optional bricht der Titel an Wörtern auf beide Zeilen um. Ein neues Lied blendet über. itunes-helper.py muss laufen.
# @author  Jeff Rainey, Niktix
# @version 2.4
# @display 52x16
# @config  host     text   "PC-Adresse"        default="" group="Verbindung" help="IP oder Name des Windows-PCs, auf dem der Helper läuft"
# @config  port     number "Port"              default=8765 min=1 max=65535 group="Verbindung"
# @config  key      text   "Schlüssel"         default="" group="Verbindung" help="Nur wenn der Helper mit --key gestartet wurde"
# @config  every    number "Intervall"         default=3 min=1 max=60 unit=s group="Verbindung"
# @config  paused   select "Bei Pause"         default=ausblenden options=ausblenden,anzeigen group="Anzeige" help="ausblenden nimmt die App aus der Rotation, solange nichts spielt"
# @config  art      bool   "Albumcover"        default=true group="Anzeige"
# @config  bar      bool   "Fortschritt"       default=true group="Anzeige"
# @config  jump     bool   "Neue Titel sofort" default=false group="Anzeige" help="Springt zu dieser App, wenn ein neuer Titel beginnt"
# @config  zeilen   bool   "Titel auf zwei Zeilen" default=false group="Anzeige" help="Bricht den Titel an ganzen Wörtern um und lässt ihn stehen. Ein zu langes Wort wird an der Silbe getrennt"
# @config  ueber    bool   "Überblenden"       default=true group="Anzeige" help="Das neue Lied wird dunkel und dann hell, statt hart umzuschalten"
# @config  bild     select "Aufbau"            default=original options=original,ruhig,beide,gross,breit group="Anzeige" help="original ist Titel oben und Interpret darunter, wie im Mac-Skript. ruhig wechselt eine Zeile. beide zeigt beide Zeilen. gross schreibt den Titel groß. breit nutzt die ganze Breite"
# @config  textart  select "Text"              default=wechsel options=titel,interpret,wechsel group="Anzeige" help="Nur beim Aufbau ruhig"
# @config  pegel    bool   "Pegel"             default=false group="Anzeige" help="Drei kleine Balken unten auf dem Cover, direkt auf dem Bild, solange etwas spielt"
# @config  uhrzeit  select "Zeit"              default=aus options=aus,rest,lauf group="Anzeige" help="Steht nur im Aufbau ruhig oder breit, und nur wenn der Titel daneben noch Platz hat"
# @config  textlauf select "Lauftext"          default=original options=original,stehen,einmal,hinher,dauernd group="Text" help="original: der Titel läuft einmal durch, der Interpret folgt der Uhr. stehen schneidet ab. einmal läuft ein Mal. hinher wandert hin und her. dauernd läuft, solange der Text nicht passt. Bei Titel auf zwei Zeilen ohne Wirkung"
# @config  hold     slider "Stillstehen"       default=1800 min=0 max=6000 step=200 unit=ms group="Text" help="Ruhe, bevor ein zu langer Text bei einmal oder hinher losläuft"
# @config  tempo    slider "Tempo"             default=90 min=30 max=150 step=5 unit=% group="Text" help="100 ist die normale Geschwindigkeit der Uhr. 90 ist die Vorgabe des Originals"
# @config  flip     number "Wechsel alle"      default=8 min=3 max=30 unit=s group="Text" help="Sekunden, bis Titel und Interpret beim Aufbau ruhig tauschen"
# @config  tcolor   color  "Titelfarbe"        default=#FFFFFF group="Farben"
# @config  acolor   color  "Interpretfarbe"    default=#FFB030 group="Farben"
# @config  bcolor   color  "Balkenfarbe"       default=#FFFFFF group="Farben"
# @config  ecolor   color  "Pegelfarbe"        default=#3DDC97 group="Farben"

import json

class ITunes
  var base, qs, every, ticks, in_flight, fails
  var state, title, artist, art_url, pos, dur, at_ms, song
  var show_paused, show_art, show_bar, show_eq, jump, wrap, do_fade
  var bild, textart, zeit, move, flip
  var tcolor, acolor, bcolor, ecolor, tscroll, ascroll
  var opt_still, opt_once, opt_bounce, opt_loop
  var cur_title, cur_artist, cur_art, cur_pos, cur_dur, cur_at, cur_state
  var pend_title, pend_artist, pend_art, pending
  var phase, phase_at, visible
  var done_t, done_a, chip_sec, chip_s
  var line1, line2, wrapped_for, wrapped_w, link

  def init()
    var host = store.get("host")
    var port = self.num("port", 8765)
    self.base = host == "" ? nil : "http://" + host + ":" + str(port)
    self.link = self.base == nil ? 0 : 1
    self.qs = store.get("key") == "" ? "" : "?k=" + store.get("key")
    self.every = self.num("every", 3)
    self.ticks = 0
    self.in_flight = false
    self.fails = 0
    self.state = "off"
    self.title = ""
    self.artist = ""
    self.art_url = nil
    self.pos = 0
    self.dur = 0
    self.at_ms = 0
    self.song = ""
    self.show_paused = store.get("paused") == "anzeigen"
    self.show_art = store.get("art")
    self.show_bar = store.get("bar")
    var pegel = store.get("pegel")
    self.show_eq = pegel == nil ? false : pegel
    self.jump = store.get("jump")
    self.wrap = store.get("zeilen")
    var fade = store.get("ueber")
    self.do_fade = fade == nil ? true : fade
    self.bild = store.get("bild")
    if self.bild == nil self.bild = "original" end
    self.textart = store.get("textart")
    if self.textart == nil self.textart = "wechsel" end
    self.zeit = store.get("uhrzeit")
    if self.zeit == nil self.zeit = "aus" end
    self.move = store.get("textlauf")
    if self.move == nil self.move = "original" end
    self.flip = self.num("flip", 8)
    if self.flip < 3 self.flip = 3 end
    self.tcolor = store.get("tcolor")
    self.acolor = store.get("acolor")
    self.bcolor = store.get("bcolor")
    self.ecolor = store.get("ecolor")
    var sp = self.num("tempo", 90)
    var pause = self.num("hold", 1800)
    self.tscroll = {"repeat": 1, "speed": sp}
    self.ascroll = {"speed": sp}
    self.opt_still = {"mode": "static", "whenFits": "static", "repeat": 0}
    self.opt_once = {"mode": "wrap", "whenFits": "static", "entry": "inline", "direction": "left", "speed": sp, "holdMs": pause, "repeat": 1}
    self.opt_bounce = {"mode": "bounce", "whenFits": "static", "entry": "inline", "direction": "left", "speed": sp, "holdMs": pause, "repeat": 0}
    self.opt_loop = {"mode": "loop", "whenFits": "static", "entry": "inline", "direction": "left", "speed": sp, "holdMs": 0, "gap": 12, "repeat": 0}
    self.cur_title = nil
    self.cur_artist = ""
    self.cur_art = nil
    self.cur_pos = 0
    self.cur_dur = 0
    self.cur_at = 0
    self.cur_state = "off"
    self.pend_title = ""
    self.pend_artist = ""
    self.pend_art = nil
    self.pending = false
    self.phase = 0
    self.phase_at = 0
    self.visible = false
    self.done_t = false
    self.done_a = false
    self.chip_sec = -1
    self.chip_s = ""
    self.line1 = ""
    self.line2 = ""
    self.wrapped_for = nil
    self.wrapped_w = -1
  end

  def num(key, fallback)
    var v = store.get(key)
    if v == nil return fallback end
    return int(v)
  end

  def on_show()
    self.visible = true
  end

  def on_hide()
    self.visible = false
    self.phase = 0
    self.pending = false
  end

  def loop()
    if self.base == nil || self.in_flight return end
    self.ticks -= 1
    if self.ticks > 0 return end
    self.ticks = self.every
    self.in_flight = true
    http.get(self.base + "/now" + self.qs, / b, st -> self.on_now(b, st), {"cap": 2048})
  end

  def on_now(body, status)
    self.in_flight = false
    if body == nil || status != 200
      self.fails += 1
      if self.fails >= 3 self.link = 1 end
      return
    end
    self.fails = 0
    self.link = 2
    var d = json.load(body)
    if !isinstance(d, map) return end
    self.state = d.find("s", "off")
    if self.state != "playing" && self.state != "paused" return end
    var song = str(d.find("t", "")) + "\n" + str(d.find("a", ""))
    var changed = song != self.song
    if changed
      self.song = song
      self.title = d.find("t", "")
      self.artist = d.find("a", "")
      var art = d.find("art")
      self.art_url = art == nil ? nil : self.base + art + self.qs
      self.done_t = false
      self.done_a = false
      self.chip_sec = -1
      if self.jump && self.state == "playing" rotation.show() end
    end
    self.pos = real(d.find("p", 0))
    self.dur = real(d.find("d", 0))
    self.at_ms = now_ms()
    if !changed && self.cur_title != nil
      self.cur_art = self.art_url
      if self.phase == 0
        self.cur_pos = self.pos
        self.cur_dur = self.dur
        self.cur_at = self.at_ms
        self.cur_state = self.state
      end
      return
    end
    if self.cur_title == nil || !self.do_fade || !self.visible
      self.show_live()
      return
    end
    self.pend_title = self.title
    self.pend_artist = self.artist
    self.pend_art = self.art_url
    self.pending = true
    if self.phase == 0
      self.phase = 1
      self.phase_at = now_ms()
    end
  end

  def show_live()
    self.cur_title = self.title
    self.cur_artist = self.artist
    self.cur_art = self.art_url
    self.cur_pos = self.pos
    self.cur_dur = self.dur
    self.cur_at = self.at_ms
    self.cur_state = self.state
    self.pending = false
    self.phase = 0
    self.wrapped_for = nil
  end

  def should_show()
    if self.link != 2 return true end
    return self.state == "playing" || (self.show_paused && self.state == "paused")
  end

  def fade_level()
    if !self.do_fade || self.phase == 0 return 100 end
    var half = 400
    var age = now_ms() - self.phase_at
    if age < 0 age = 0 end
    if self.phase == 1
      if age >= half
        self.cur_title = self.pend_title
        self.cur_artist = self.pend_artist
        self.cur_art = self.pend_art
        self.cur_pos = self.pos
        self.cur_dur = self.dur
        self.cur_at = self.at_ms
        self.cur_state = self.state
        self.pending = false
        self.phase = 2
        self.phase_at = now_ms()
        self.wrapped_for = nil
        self.done_t = false
        self.done_a = false
        return 0
      end
      return 100 - age * 100 / half
    end
    if age >= half
      self.phase = 0
      return 100
    end
    return age * 100 / half
  end

  def shade(color, pct)
    if pct >= 100 return color end
    if pct <= 0 || color == nil return 0 end
    var r = ((color >> 16) & 255) * pct / 100
    var g = ((color >> 8) & 255) * pct / 100
    var b = (color & 255) * pct / 100
    return (r << 16) + (g << 8) + b
  end

  def title_line()
    if self.cur_title == nil || self.cur_title == "" return "—" end
    return self.cur_title
  end

  def shown()
    var title = self.title_line()
    if self.textart == "titel" || self.cur_artist == "" return title end
    if self.textart == "interpret" return self.cur_artist end
    var slot = int(now_ms() / 1000) / self.flip
    if slot % 2 == 0 return title end
    return self.cur_artist
  end

  def elapsed()
    var p = self.cur_pos
    if self.cur_state == "playing" && self.phase != 1 p += (now_ms() - self.cur_at) / 1000.0 end
    if p < 0 p = 0 end
    if self.cur_dur > 0 && p > self.cur_dur p = self.cur_dur end
    return p
  end

  def chip()
    if self.zeit == "aus" || self.cur_dur <= 0 return "" end
    var sec = int(self.elapsed())
    if self.zeit == "rest"
      sec = int(self.cur_dur) - sec
      if sec < 0 sec = 0 end
    end
    if sec != self.chip_sec
      self.chip_sec = sec
      var m = sec / 60
      var r = sec % 60
      var rs = str(r)
      if r < 10 rs = "0" + rs end
      self.chip_s = str(m) + ":" + rs
    end
    return self.chip_s
  end

  def finished(line)
    if line == self.title_line() return self.done_t end
    return self.done_a
  end

  def mark(line)
    if line == self.title_line()
      self.done_t = true
    else
      self.done_a = true
    end
  end

  def moving(x, y, w, line, col, primary)
    if line == "" return end
    if self.move == "original"
      scroll_text(x, y, w, line, col, primary ? self.tscroll : self.ascroll)
      return
    end
    var too_long = text_ink_width(line) > w
    var once = self.move == "einmal" && too_long && !self.finished(line)
    var opt = self.opt_still
    if once
      opt = self.opt_once
    elif too_long && self.move == "dauernd"
      opt = self.opt_loop
    elif too_long && self.move == "hinher"
      opt = self.opt_bounce
    end
    var n = scroll_text(x, y, w, line, col, opt)
    if once && n != nil && n >= 1 self.mark(line) end
  end

  def still(x, y, w, s, col)
    if s == "" return end
    var ink = text_ink_width(s)
    var x0 = x
    if ink < w x0 = x + (w - ink) / 2 end
    text(x0, y, s, col)
  end

  # Ein Zeichen, auch wenn es mehrere Bytes hat. So bleibt „ä“ ganz.
  def utf8_len_at(s, i)
    var c = s[i .. i]
    if c >= "\xF0" return 4 end
    if c >= "\xE0" return 3 end
    if c >= "\xC0" return 2 end
    return 1
  end

  def chars_of(s)
    var out = []
    var i = 0
    var n = size(s)
    while i < n
      var len = self.utf8_len_at(s, i)
      if i + len > n len = 1 end
      var endi = i + len - 1
      out.push(s[i .. endi])
      i += len
    end
    return out
  end

  def join_chars(cs, a, b)
    var s = ""
    var i = a
    while i < b
      s += cs[i]
      i += 1
    end
    return s
  end

  def fold(ch)
    if size(ch) != 1
      if ch == "Ä" return "ä" end
      if ch == "Ö" return "ö" end
      if ch == "Ü" return "ü" end
      if ch == "ẞ" return "ß" end
      return ch
    end
    var U = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var L = "abcdefghijklmnopqrstuvwxyz"
    var i = 0
    while i < 26
      if ch == U[i .. i] return L[i .. i] end
      i += 1
    end
    return ch
  end

  def listed(key, table)
    var needle = " " + key + " "
    var n = size(table)
    var m = size(needle)
    if m == 0 || m > n return false end
    var last = n - m
    var i = 0
    while i <= last
      var endi = i + m - 1
      if table[i .. endi] == needle return true end
      i += 1
    end
    return false
  end

  def is_vowel(ch)
    var c = self.fold(ch)
    if size(c) != 1
      return c == "ä" || c == "ö" || c == "ü" || c == "á" || c == "é" || c == "í" || c == "ó" || c == "ú" || c == "à" || c == "è" || c == "ì" || c == "ò" || c == "ù" || c == "â" || c == "ê" || c == "î" || c == "ô" || c == "û"
    end
    return c == "a" || c == "e" || c == "i" || c == "o" || c == "u"
  end

  def is_diphthong(a, b)
    return self.listed(self.fold(a) + self.fold(b), " ai au ay ea ee ei eu ey ia ie ii io oa oe oi oo ou oy ui aa äu ")
  end

  def is_word_char(ch)
    if self.is_vowel(ch) return true end
    if ch == "y" || ch == "Y" || ch == "'" || ch == "’" || ch == "ß" || ch == "ẞ" return true end
    if size(ch) != 1 return false end
    var c = self.fold(ch)
    if c >= "a" && c <= "z" return true end
    if c >= "0" && c <= "9" return true end
    return false
  end

  def is_space_ch(ch)
    return ch == " " || ch == "\t"
  end

  def is_hyphen_ch(ch)
    return ch == "-" || ch == "–" || ch == "—" || ch == "/"
  end

  def has_german_mark(cs)
    var i = 0
    var n = size(cs)
    while i < n
      var ch = cs[i]
      if ch == "ä" || ch == "ö" || ch == "ü" || ch == "Ä" || ch == "Ö" || ch == "Ü" || ch == "ß" || ch == "ẞ"
        return true
      end
      i += 1
    end
    return false
  end

  def same_ch(a, b)
    return self.fold(a) == self.fold(b)
  end

  def cluster_key(cs, a, b)
    var s = ""
    var i = a
    while i < b
      s += self.fold(cs[i])
      i += 1
    end
    return s
  end

  def is_liquid(key)
    if size(key) != 2 return false end
    var b = key[1 .. 1]
    if b != "l" && b != "r" return false end
    var a = key[0 .. 0]
    return a == "b" || a == "c" || a == "d" || a == "f" || a == "g" || a == "k" || a == "p" || a == "t" || a == "v"
  end

  def is_digraph(key)
    return self.listed(key, " ch sh th ph ck wh sch pf ")
  end

  def is_onset(key)
    return self.listed(key, " ch sh th ph ck wh sch pf bl br cl cr dr fl fr gl gr kl kr pl pr tr vl vr st sp sk sl sm sn sw str spr scr schr thr ")
  end

  # Schnitt vor der nächsten Silbe. c0 ist der erste Mitlaut, c1 der folgende Vokal.
  def onset_cut(cs, c0, c1)
    var clen = c1 - c0
    if clen <= 1 return c0 end
    if self.same_ch(cs[c0], cs[c0 + 1])
      if clen >= 3 && self.same_ch(cs[c0], cs[c0 + 2]) return c0 + 2 end
      return c0 + 1
    end
    var whole = self.cluster_key(cs, c0, c1)
    if self.is_liquid(whole) || self.is_digraph(whole) return c0 end
    var best = c0 + 1
    var length = clen - 1
    while length >= 1
      var key = self.cluster_key(cs, c1 - length, c1)
      if length == 1 || self.is_onset(key) || self.is_liquid(key) || self.is_digraph(key)
        best = c1 - length
        break
      end
      length -= 1
    end
    return best
  end

  def silent_e(cs, vowel)
    var n = size(cs)
    if n < 4 || self.has_german_mark(cs) return end
    if self.fold(cs[n - 1]) != "e" || !vowel[n - 1] return end
    if self.fold(cs[n - 2]) == "l" && !vowel[n - 2] return end
    var k = n - 2
    var cons = 0
    while k >= 0 && !vowel[k]
      cons += 1
      k -= 1
    end
    if cons == 1 && k >= 0 vowel[n - 1] = false end
  end

  def vowel_flags(cs)
    var vowel = []
    var n = size(cs)
    var i = 0
    while i < n
      var ch = cs[i]
      var v = self.is_vowel(ch)
      if ch == "y" || ch == "Y" v = i > 0 end
      vowel.push(v)
      i += 1
    end
    self.silent_e(cs, vowel)
    return vowel
  end

  def vowel_starts(cs, vowel)
    var starts = []
    var n = size(cs)
    var i = 0
    var in_g = false
    var prev = 0
    while i < n
      if vowel[i]
        if !in_g
          starts.push(i)
          in_g = true
        elif !self.is_diphthong(cs[prev], cs[i])
          starts.push(i)
        end
        prev = i
      else
        in_g = false
      end
      i += 1
    end
    return starts
  end

  def cut_ok(cut, n, vowel)
    if cut <= 0 || cut >= n return false end
    if n - cut < 2 return false end
    if cut >= 2 return true end
    return vowel[0]
  end

  def syllables(word)
    var cs = self.chars_of(word)
    var n = size(cs)
    if n <= 4 return [word] end
    var vowel = self.vowel_flags(cs)
    var starts = self.vowel_starts(cs, vowel)
    if size(starts) <= 1 return [word] end
    var cuts = []
    var g = 1
    var gs = size(starts)
    while g < gs
      var p = starts[g] - 1
      while p >= 0 && !vowel[p] p -= 1 end
      var c0 = p + 1
      var c1 = starts[g]
      var cut = c1
      if c1 > c0 cut = self.onset_cut(cs, c0, c1) end
      if self.cut_ok(cut, n, vowel) cuts.push(cut) end
      g += 1
    end
    if size(cuts) == 0 return [word] end
    var pieces = []
    var prev = 0
    var ci = 0
    var cn = size(cuts)
    while ci < cn
      var c = cuts[ci]
      if c > prev
        pieces.push(self.join_chars(cs, prev, c))
        prev = c
      end
      ci += 1
    end
    if prev < n pieces.push(self.join_chars(cs, prev, n)) end
    if size(pieces) == 0 return [word] end
    return pieces
  end

  def segments(title, w)
    var cs = self.chars_of(title)
    var n = size(cs)
    var segs = []
    var i = 0
    while i < n
      var ch = cs[i]
      if self.is_space_ch(ch)
        var j = i + 1
        while j < n && self.is_space_ch(cs[j]) j += 1 end
        segs.push({"t": self.join_chars(cs, i, j), "br": false, "hy": false})
        i = j
      elif self.is_hyphen_ch(ch)
        segs.push({"t": ch, "br": true, "hy": false})
        i += 1
      elif self.is_word_char(ch)
        var j = i + 1
        while j < n && self.is_word_char(cs[j]) j += 1 end
        var word = self.join_chars(cs, i, j)
        var pieces = [word]
        if text_ink_width(word) > w pieces = self.syllables(word) end
        if size(pieces) == 0 pieces = [word] end
        var p = 0
        var pn = size(pieces)
        while p < pn
          var last = p == pn - 1
          var hy = !last && pn > 1
          var br = true
          if last && j < n && self.is_hyphen_ch(cs[j]) br = false end
          segs.push({"t": pieces[p], "br": br, "hy": hy})
          p += 1
        end
        i = j
      else
        segs.push({"t": ch, "br": true, "hy": false})
        i += 1
      end
    end
    return segs
  end

  def side_text(segs, cut, hyphen)
    var s = ""
    var i = 0
    while i < cut
      s += segs[i]["t"]
      i += 1
    end
    if hyphen && s != ""
      var m = size(s)
      if s[m - 1 .. m - 1] != "-" s += "-" end
    end
    return s
  end

  def right_text(segs, cut)
    var s = ""
    var i = cut
    var n = size(segs)
    while i < n
      s += segs[i]["t"]
      i += 1
    end
    var k = 0
    var m = size(s)
    while k < m
      var ch = s[k .. k]
      if ch != " " && ch != "\t" break end
      k += 1
    end
    if k == 0 return s end
    if k >= m return "" end
    return s[k .. m - 1]
  end

  def hard_cut(title, w)
    var cs = self.chars_of(title)
    var n = size(cs)
    var best = 1
    var i = 1
    while i < n
      var left = self.join_chars(cs, 0, i) + "-"
      if text_ink_width(left) <= w best = i end
      i += 1
    end
    if best >= n
      self.line1 = title
      self.line2 = ""
      return
    end
    self.line1 = self.join_chars(cs, 0, best) + "-"
    self.line2 = self.join_chars(cs, best, n)
  end

  # Ganze Wörter auf die erste Zeile. Nur ein Wort, das allein nicht passt, wird an der Silbe getrennt.
  def fit_lines(title, w)
    self.wrapped_for = title
    self.wrapped_w = w
    if title == ""
      self.line1 = "—"
      self.line2 = ""
      return
    end
    if text_ink_width(title) <= w
      self.line1 = title
      self.line2 = ""
      return
    end
    var segs = self.segments(title, w)
    var n = size(segs)
    var best = -1
    var best_score = -1
    var i = 0
    while i < n
      var seg = segs[i]
      if seg["br"]
        var left = self.side_text(segs, i + 1, seg["hy"])
        var right = self.right_text(segs, i + 1)
        if right != "" && text_ink_width(left) <= w
          var both = text_ink_width(right) <= w
          var rank = 1
          if both && seg["hy"] rank = 2 end
          if both && !seg["hy"] rank = 3 end
          var score = rank * 1000 + text_ink_width(left)
          if score >= best_score
            best_score = score
            best = i
          end
        end
      end
      i += 1
    end
    if best >= 0
      var seg = segs[best]
      self.line1 = self.side_text(segs, best + 1, seg["hy"])
      self.line2 = self.right_text(segs, best + 1)
      return
    end
    self.hard_cut(title, w)
  end

  # 0..70 hoch und wieder runter, daraus eine Helligkeit zwischen lo und hi.
  def glow(asleep)
    var pace = asleep ? 55 : 32
    var t = int(now_ms() / pace) % 140
    if t > 70 t = 140 - t end
    var lo = asleep ? 24 : 46
    var hi = asleep ? 58 : 100
    return lo + t * (hi - lo) / 70
  end

  def idle_line(x, y, w, s, col)
    var ink = text_ink_width(s)
    var x0 = x
    if ink < w x0 = x + (w - ink) / 2 end
    text(x0, y, s, col)
  end

  # Achtelnote, fest gezeichnet, damit der Kopf rund bleibt.
  def paint_note(col)
    rect_fill(4, 8, 3, 1, col)
    rect_fill(3, 9, 5, 1, col)
    rect_fill(3, 10, 5, 1, col)
    rect_fill(3, 11, 5, 1, col)
    rect_fill(4, 12, 3, 1, col)
    rect_fill(8, 1, 2, 9, col)
    rect_fill(10, 1, 4, 2, col)
    rect_fill(12, 3, 2, 1, col)
    rect_fill(13, 4, 1, 1, col)
  end

  def draw_standby(missing)
    font("small")
    var asleep = !missing
    var note = missing ? 0xFFB030 : 0x7D8B96
    var ink = missing ? 0xFFFFFF : 0xD5DDE4
    var sub = missing ? 0xFFB030 : 0x8A97A3
    var line = missing ? 0xFFB030 : 0x5C6B78
    self.paint_note(self.shade(note, self.glow(asleep)))
    self.idle_line(18, 6, 34, missing ? "Adresse" : "Offline", ink)
    self.idle_line(18, 13, 34, missing ? "fehlt" : "kein PC", sub)
    rect_fill(18, 15, 34, 1, self.shade(line, 32))
  end

  def draw()
    clear()
    if self.link != 2
      self.draw_standby(self.link == 0)
      return
    end
    var level = self.fade_level()
    var playing = self.cur_state == "playing"
    var tc = self.shade(playing ? self.tcolor : 0x707070, level)
    var ac = self.shade(playing ? self.acolor : 0x505050, level)
    font("small")
    if !self.wrap && self.bild == "gross"
      self.draw_big(tc, playing, level)
      return
    end
    var x = 0
    if self.wrap || (self.bild != "breit")
      x = self.paint_cover(level)
      self.paint_eq(playing, level)
    end
    if self.wrap
      self.draw_wrap(x, tc, ac, playing, level)
    elif self.bild == "ruhig" || self.bild == "breit"
      self.draw_card(x, tc, ac, playing, level)
    elif self.bild == "beide"
      self.draw_pair(x, tc, ac, playing, level)
    else
      self.draw_original(x, tc, ac, playing, level)
    end
  end

  def draw_original(x, tc, ac, playing, level)
    var w = width() - x
    var title = self.cur_title == nil ? "" : self.cur_title
    self.moving(x, 6, w, title, tc, true)
    self.moving(x, 13, w, self.cur_artist, ac, false)
    self.paint_bar(x, playing, level)
  end

  def draw_wrap(x, tc, ac, playing, level)
    var w = width() - x
    var title = self.cur_title == nil ? "" : self.cur_title
    if title != self.wrapped_for || w != self.wrapped_w self.fit_lines(title, w) end
    self.still(x, 6, w, self.line1, tc)
    if self.line2 != ""
      self.still(x, 13, w, self.line2, tc)
    elif self.cur_artist != ""
      self.still(x, 13, w, self.cur_artist, ac)
    end
    self.paint_bar(x, playing, level)
  end

  def draw_card(x, tc, ac, playing, level)
    var line = self.shown()
    var col = line == self.cur_artist && self.cur_artist != "" ? ac : tc
    var full = width() - x
    var chip = self.chip()
    var gap = 0
    if chip != ""
      var cw = text_ink_width(chip) + 2
      if text_ink_width(line) + cw <= full
        gap = cw
        text(width() - (cw - 2), 8, chip, ac)
      end
    end
    self.moving(x, 8, full - gap, line, col, true)
    self.paint_bar(x, playing, level)
  end

  def draw_pair(x, tc, ac, playing, level)
    var title = self.title_line()
    var w = width() - x
    if self.move == "original"
      self.moving(x, 6, w, title, tc, true)
      self.moving(x, 13, w, self.cur_artist, ac, false)
    else
      var title_long = text_ink_width(title) > w
      var artist_long = self.cur_artist != "" && text_ink_width(self.cur_artist) > w
      if artist_long && !title_long
        self.still(x, 6, w, title, tc)
        self.moving(x, 13, w, self.cur_artist, ac, false)
      else
        if title_long
          self.moving(x, 6, w, title, tc, true)
        else
          self.still(x, 6, w, title, tc)
        end
        if self.cur_artist != "" self.still(x, 13, w, self.cur_artist, ac) end
      end
    end
    self.paint_bar(x, playing, level)
  end

  def draw_big(tc, playing, level)
    font("large")
    self.moving(0, 7, width(), self.title_line(), tc, true)
    self.paint_bar(0, playing, level)
  end

  def paint_cover(level)
    if !self.show_art return 0 end
    if self.cur_art == nil || !icon(self.cur_art, 0, 0)
      rect_fill(0, 0, 16, 16, self.shade(0x202020, level))
    end
    return 18
  end

  # Balken direkt auf dem Cover, ohne dunkle Fläche dahinter.
  def paint_eq(playing, level)
    if !self.show_eq || !self.show_art return end
    var col = self.shade(playing ? self.ecolor : 0x404040, level)
    var t = int(now_ms() / 180)
    for i : 0 .. 2
      var h = 2
      if playing h = 2 + ((t + i * 3) % 5) end
      rect_fill(1 + i * 2, 16 - h, 1, h, col)
    end
  end

  def paint_bar(x, playing, level)
    if !self.show_bar || self.cur_dur <= 0 return end
    var pct = int(self.elapsed() * 100 / self.cur_dur)
    if pct < 0 pct = 0 end
    progress(pct > 100 ? 100 : pct, self.shade(playing ? self.bcolor : 0x505050, level), self.shade(0x202020, level), x)
  end
end

return ITunes()
